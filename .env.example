PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/elite_library
APP_TIMEZONE=Asia/Kathmandu
DELIVERY_FEE=150

# Cloudinary Configuration (Required for image uploads)
# The API key needs permission to create and delete assets (for example, the
# Media Library Admin role under Cloudinary Settings > API Keys > Assign Roles).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin Credentials (Required for admin login)
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=
ADMIN_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-a-long-random-secret
